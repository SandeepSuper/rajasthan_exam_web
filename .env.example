# Copy to .env.local and fill in.

# Where the browser sends API calls. Leave as /api when the website is served
# from the same domain as the backend (recommended, via nginx).
VITE_API_BASE_URL=/api

# Dev only: backend that `npm run dev` forwards /api calls to.
# Use http://localhost:8080 for a local backend, or the live server URL.
VITE_DEV_API_TARGET=https://exam.photopassport.in

# Google Sign-In. Use the same *Web* OAuth client ID the backend uses
# (app.google.client-id). Add this website's URL to "Authorized JavaScript origins"
# in Google Cloud Console. Leave empty to hide the Google button.
VITE_GOOGLE_CLIENT_ID=
